{
  "name": "kmy-terminal",
  "version": "0.1.3-beta",
  "description": "kmy terminal — yapay zekâ destekli BIST terminali",
  "main": "server/index.js",
  "bin": {
    "kmy-terminal": "bin/start.mjs",
    "kmy": "bin/kmy"
  },
  "scripts": {
    "start": "node bin/start.mjs",
    "test": "node scripts/run-tests.mjs",
    "denetim": "node scripts/veri-denetimi.mjs",
    "open": "bin/kmy-terminal",
    "mcp": "node server/mcp-stdio.js",
    "postinstall": "node scripts/postinstall.mjs",
    "gateway": "node bin/kmy gateway",
    "setup": "sh scripts/install.sh",
    "mac": "./scripts/build-mac.sh --install",
    "dmg": "./scripts/build-dmg.sh",
    "server": "node server/index.js",
    "lint": "eslint .",
    "format:check": "prettier --check server/yolo.js server/web-security.js test/sertlestirme.test.mjs eslint.config.js server/update-verify.js server/update-key.js test/guncelleme-uygula.test.mjs",
    "format": "prettier --write server/yolo.js server/web-security.js test/sertlestirme.test.mjs eslint.config.js server/update-verify.js server/update-key.js test/guncelleme-uygula.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.14",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "engines": {
    "node": ">=22.13"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
